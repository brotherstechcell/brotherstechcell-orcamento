---
interface Props {
  serviceName?: string;
  deliveryLabel?: string;
  estimatedTime?: string;
}

const {
  serviceName = "reparo",
  deliveryLabel = "Atendimento delivery em domicílio",
  estimatedTime = "20 a 40 minutos"
} = Astro.props;
---
<section class="delivery-highlight-section">
  <div class="container">
    <div class="delivery-highlight-banner">
      <div class="delivery-badge-tag">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="1" y="3" width="15" height="13"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
        <span>Assistência Delivery em Toda Manaus</span>
      </div>

      <h3 class="delivery-title type-h2-32">Nós Vamos Até Você — Sem Filas e Sem Deixar o Aparelho</h3>
      <p class="delivery-text type-body-16">
        Esqueça o transtorno de ir ao shopping ou deixar seu iPhone por dias em uma bancada fechada. 
        Nossos técnicos especializados vão até sua residência, escritório ou condomínio em Manaus com ferramental profissional de precisão. 
        O {serviceName} é realizado com total transparência e você acompanha cada etapa na sua frente.
      </p>

      <div class="delivery-perks-grid">
        <div class="perk-item">
          <span class="perk-icon">⏱️</span>
          <div>
            <strong>Tempo Médio:</strong>
            <span>{estimatedTime}</span>
          </div>
        </div>
        <div class="perk-item">
          <span class="perk-icon">📍</span>
          <div>
            <strong>Modalidade:</strong>
            <span>{deliveryLabel}</span>
          </div>
        </div>
        <div class="perk-item">
          <span class="perk-icon">🔒</span>
          <div>
            <strong>Privacidade:</strong>
            <span>Seus dados nunca são acessados</span>
          </div>
        </div>
        <div class="perk-item">
          <span class="perk-icon">🛡️</span>
          <div>
            <strong>Garantia:</strong>
            <span>Garantia real de até 6 meses</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .delivery-highlight-section {
    padding: 32px 0 48px;
  }
  .delivery-highlight-banner {
    background: #FFFFFF;
    border: 1px solid var(--border, #E5E7EB);
    border-radius: var(--radius-lg, 20px);
    padding: 36px 32px;
    box-shadow: var(--shadow-sm, 0 2px 8px rgba(15, 23, 42, 0.06));
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .delivery-highlight-banner:hover {
    border-color: rgba(41, 162, 81, 0.3);
    box-shadow: var(--shadow-md, 0 8px 24px rgba(15, 23, 42, 0.08));
  }
  .delivery-badge-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--primary-transparent, rgba(41, 162, 81, 0.08));
    color: var(--primary-dark, #1A532D);
    font-weight: 700;
    font-size: 0.825rem;
    padding: 6px 14px;
    border-radius: var(--radius-pill, 999px);
    border: 1px solid rgba(41, 162, 81, 0.2);
    margin-bottom: 16px;
  }
  .delivery-title {
    color: var(--text-primary, #111214);
    margin-bottom: 14px;
  }
  .delivery-text {
    color: var(--text-secondary, #4B5563);
    max-width: 820px;
    line-height: 1.6;
    margin-bottom: 28px;
  }
  .delivery-perks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    border-top: 1px solid var(--border, #E5E7EB);
    padding-top: 24px;
  }
  .perk-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .perk-icon {
    font-size: 1.5rem;
  }
  .perk-item strong {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted, #6B7280);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .perk-item span {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary, #111214);
  }
</style>
