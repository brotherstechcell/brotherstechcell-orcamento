---
import { CONFIG } from '../scripts/prices.js';

const LOGICAL_MODEL_ORDER = [
  "17 Pro Max", "17 Pro", "17 Plus", "17",
  "16 Pro Max", "16 Pro", "16 Plus", "16",
  "15 Pro Max", "15 Pro", "15 Plus", "15",
  "14 Pro Max", "14 Pro", "14 Plus", "14",
  "13 Pro Max", "13 Pro", "13 Mini", "13",
  "12 Pro Max", "12 Pro", "12 Mini", "12",
  "11 Pro Max", "11 Pro", "11",
  "XS Max", "XS", "XR", "X",
  "SE 2/3",
  "8 Plus", "8",
  "7 Plus", "7",
  "6S Plus", "6S", "6"
];

const LOGICAL_MODEL_GROUPS = [
  { label: "Linha iPhone 17", models: ["17 Pro Max", "17 Pro", "17 Plus", "17"] },
  { label: "Linha iPhone 16", models: ["16 Pro Max", "16 Pro", "16 Plus", "16"] },
  { label: "Linha iPhone 15", models: ["15 Pro Max", "15 Pro", "15 Plus", "15"] },
  { label: "Linha iPhone 14", models: ["14 Pro Max", "14 Pro", "14 Plus", "14"] },
  { label: "Linha iPhone 13", models: ["13 Pro Max", "13 Pro", "13 Mini", "13"] },
  { label: "Linha iPhone 12 & 11", models: ["12 Pro Max", "12 Pro", "12 Mini", "12", "11 Pro Max", "11 Pro", "11"] },
  { label: "Modelos Anteriores", models: ["XS Max", "XS", "XR", "X", "SE 2/3", "8 Plus", "8", "7 Plus", "7", "6S Plus", "6S", "6"] }
];

const sortedModels = Object.keys(CONFIG.devices || {}).sort((a, b) => {
  const indexA = LOGICAL_MODEL_ORDER.indexOf(a);
  const indexB = LOGICAL_MODEL_ORDER.indexOf(b);
  if (indexA !== -1 && indexB !== -1) return indexA - indexB;
  if (indexA !== -1) return -1;
  if (indexB !== -1) return 1;
  return a.localeCompare(b);
});

const defaultModel = sortedModels[0] || "16 Pro Max";
const defaultData = CONFIG.devices?.[defaultModel] || {};

const qualitiesOrder = ["Premium", "Econômica"];
const screenQualities = defaultData.tela 
  ? Object.keys(defaultData.tela)
      .filter(q => q.toLowerCase() !== "básica" && q.toLowerCase() !== "basica")
      .sort((a,b) => qualitiesOrder.indexOf(a) - qualitiesOrder.indexOf(b))
  : [];
const batteryQualities = defaultData.bateria 
  ? Object.keys(defaultData.bateria)
      .filter(q => q.toLowerCase() !== "básica" && q.toLowerCase() !== "basica")
      .sort((a,b) => qualitiesOrder.indexOf(a) - qualitiesOrder.indexOf(b))
  : [];
---

    <!-- Seção de Telas e Baterias (Seletor Único) -->
    <section id="telas-precos">
      <div class="container">
        <div class="section-header scroll-reveal scroll-top">
          <span class="section-label">Preços na Hora</span>
          <h2 class="section-title type-h2-44">Escolha o seu iPhone</h2>
          <p class="section-subtitle type-subheading-20">Consulte o valor exato da troca de Tela e Bateria do seu
            aparelho na hora, ou solicite outros serviços pelo WhatsApp.</p>
        </div>

        <!-- Componente Principal do Seletor -->
        <div class="pricing-selector-container">
          <!-- Abas de Categoria Superior -->
          <div class="selector-tabs" role="tablist">
            <button class="selector-tab active" id="tab-btn-telas-baterias" role="tab" aria-selected="true"
              aria-controls="panel-telas-baterias">Telas e Baterias</button>
            <button class="selector-tab" id="tab-btn-outros-servicos" role="tab" aria-selected="false"
              aria-controls="panel-outros-servicos">Outros Serviços</button>
          </div>

          <!-- Painel 1: Telas e Baterias -->
          <div class="selector-panel active" id="panel-telas-baterias" role="tabpanel">
            
            <!-- Barra de Pesquisa Única e Inteligente -->
            <div class="device-single-search-wrapper" style="max-width: 600px; margin: 0 auto 28px; text-align: center;">
              <label for="device-search-input" class="search-label" style="font-size: 1.15rem; font-weight: 700; margin-bottom: 12px; display: block;">Digite o Modelo do seu iPhone:</label>
              
              <div class="single-search-box-container" style="position: relative;">
                <input type="text" id="device-search-input" class="device-search-input-field" placeholder="🔍 Digite aqui (ex: 15 Pro Max, 13, XR, 12 Pro, 11...)" autocomplete="off" />
                <span id="search-input-clear-btn" style="position: absolute; right: 16px; top: 50%; transform: translateY(-50%); cursor: pointer; display: none; font-weight: 700; color: var(--text-muted); font-size: 1.1rem; padding: 4px;">✕</span>
              </div>

              <!-- Badge de Modelo Ativo em Tempo Real -->
              <div id="search-matched-badge" class="search-matched-badge" style="margin-top: 12px; display: inline-flex; align-items: center; gap: 6px; background: rgba(41, 162, 81, 0.12); color: var(--primary-dark, #29a251); font-weight: 700; font-size: 0.9rem; padding: 8px 18px; border-radius: 50px; border: 1.5px solid rgba(41, 162, 81, 0.3);">
                <span>✓ Exibindo preços para: <strong id="matched-model-name" style="color: var(--primary-dark, #29a251);">iPhone 16 Pro Max</strong></span>
              </div>

              <!-- Sugestões de Autocompletar Rápido (Exibidas ao digitar) -->
              <div id="search-autocomplete-suggestions" class="search-autocomplete-suggestions" style="display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: 14px;">
                <!-- Populado dinamicamente via JS com modelos relacionados -->
              </div>

              <!-- Hidden select for compatibility/fallback -->
              <select id="device-search-select" class="search-select-dropdown" style="display: none;">
                {LOGICAL_MODEL_GROUPS.map(group => {
                  const groupModels = group.models.filter(m => (CONFIG.devices || {})[m]);
                  if (groupModels.length === 0) return null;
                  return (
                    <optgroup label={group.label}>
                      {groupModels.map(model => (
                        <option value={model} selected={model === defaultModel}>iPhone {model}</option>
                      ))}
                    </optgroup>
                  );
                })}
              </select>
            </div>

            <!-- Grid de Resultados de Tela e Bateria do Modelo Selecionado (Pre-renderizado no servidor) -->
            <div class="results-grid" id="selector-results-grid">
              <!-- Card Tela -->
              <div class="price-selector-card fancy-card">
                <div class="card-inner">
                  <div class="service-header-row">
                    <span class="icon-service-type">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="5" y="2" width="14" height="20" rx="3" ry="3"></rect>
                        <line x1="12" y1="18" x2="12.01" y2="18"></line>
                      </svg>
                    </span>
                    <div>
                      <h4 class="service-title-text">Tela de iPhone {defaultModel}</h4>
                      <span class="service-subtitle-text">Substituição rápida e garantida</span>
                    </div>
                  </div>
                  <div class="service-pricing-list">
                    {screenQualities.map(quality => {
                      const qData = defaultData.tela[quality];
                      const isPremium = quality.toLowerCase() === 'premium';
                      const displayQuality = quality.toLowerCase().includes('intermediár') ? 'Econômica' : quality;
                      const priceText = qData.price.toLowerCase().includes('consulta') ? qData.price : `R$ ${qData.price}`;
                      const installmentText = qData.price.toLowerCase().includes('consulta') ? '' : `ou ${qData.installment}`;
                      return (
                        <div class={isPremium ? "service-quality-row premium-featured" : "service-quality-row"}>
                          <div class="quality-row-main">
                            <div class="quality-label">
                              <div class="quality-badge-wrapper" style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                <span class={`quality-badge ${displayQuality.toLowerCase()}`}>{displayQuality}</span>
                                {isPremium && <span class="premium-recommend-badge" style="font-size: 0.65rem; background: linear-gradient(135deg, #ff9f43 0%, #ff5252 100%); color: #fff; padding: 3px 8px; border-radius: 4px; font-weight: 800; letter-spacing: 0.03em; box-shadow: 0 2px 8px rgba(255, 82, 82, 0.3);">🔥 MAIS VENDIDA</span>}
                              </div>
                              <div class="quality-benefits-wrapper">
                                <span class="benefit-item warranty">
                                  <svg viewBox="0 0 24 24" class="benefit-icon"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
                                  {isPremium ? '6 Meses de Garantia' : '3 Meses de Garantia'}
                                </span>
                                {isPremium && (
                                  <span class="benefit-item gift">
                                    <svg viewBox="0 0 24 24" class="benefit-icon"><path d="M20 6h-2.18c.11-.31.18-.65.18-1 0-1.66-1.34-3-3-3-1.05 0-1.96.54-2.5 1.35l-.5.65-.5-.65C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm11 15H4V8h16v11z"/></svg>
                                    Película + Capinha Grátis
                                  </span>
                                )}
                              </div>
                            </div>
                            <div class="quality-pricing">
                              <span class="quality-price-cash">{priceText}</span>
                              <span class="quality-price-install">{installmentText}</span>
                            </div>
                          </div>
                          <div class="quality-action">
                            <a href={`https://brothersystem.vercel.app/agendar?link=tela&device=${encodeURIComponent(defaultModel)}&quality=${encodeURIComponent(displayQuality)}`} target="_blank" rel="noopener noreferrer" class={isPremium ? "btn-quality-order btn-premium-cta" : "btn-quality-order"}>
                              {isPremium ? 'AGENDAR PREMIUM' : 'AGENDAR'}
                            </a>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              </div>

              <!-- Card Bateria -->
              <div class="price-selector-card fancy-card">
                <div class="card-inner">
                  <div class="service-header-row">
                    <span class="icon-service-type battery">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="7" width="16" height="10" rx="2" ry="2"></rect>
                        <line x1="22" y1="11" x2="22" y2="13"></line>
                        <line x1="6" y1="11" x2="6" y2="13"></line>
                        <line x1="10" y1="11" x2="10" y2="13"></line>
                      </svg>
                    </span>
                    <div>
                      <h4 class="service-title-text">Bateria de iPhone {defaultModel}</h4>
                      <span class="service-subtitle-text">Saúde 100% com selo Anatel</span>
                    </div>
                  </div>
                  <div class="service-pricing-list">
                    {batteryQualities.map(quality => {
                      const qData = defaultData.bateria[quality];
                      const isPremium = quality.toLowerCase() === 'premium';
                      const displayQuality = quality.toLowerCase().includes('intermediár') ? 'Econômica' : quality;
                      const priceText = qData.price.toLowerCase().includes('consulta') ? qData.price : `R$ ${qData.price}`;
                      const installmentText = qData.price.toLowerCase().includes('consulta') ? '' : `ou ${qData.installment}`;
                      return (
                        <div class="service-quality-row">
                          <div class="quality-row-main">
                            <div class="quality-label">
                              <span class={`quality-badge ${displayQuality.toLowerCase()}`}>{displayQuality}</span>
                              <div class="quality-benefits-wrapper">
                                <span class="benefit-item warranty">
                                  <svg viewBox="0 0 24 24" class="benefit-icon"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
                                  {isPremium ? '6 Meses de Garantia' : '3 Meses de Garantia'}
                                </span>
                                {isPremium && (
                                  <span class="benefit-item gift">
                                    <svg viewBox="0 0 24 24" class="benefit-icon"><path d="M20 6h-2.18c.11-.31.18-.65.18-1 0-1.66-1.34-3-3-3-1.05 0-1.96.54-2.5 1.35l-.5.65-.5-.65C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm11 15H4V8h16v11z"/></svg>
                                    Película + Capinha Grátis
                                  </span>
                                )}
                              </div>
                            </div>
                            <div class="quality-pricing">
                              <span class="quality-price-cash">{priceText}</span>
                              <span class="quality-price-install">{installmentText}</span>
                            </div>
                          </div>
                          <div class="quality-action">
                            <a href={`https://brothersystem.vercel.app/agendar?link=bateria&device=${encodeURIComponent(defaultModel)}&quality=${encodeURIComponent(displayQuality)}`} target="_blank" rel="noopener noreferrer" class="btn-quality-order">
                              AGENDAR
                            </a>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Painel 2: Outros Serviços -->
          <div class="selector-panel" id="panel-outros-servicos" role="tabpanel">
            <div class="other-services-showcase">
              <div class="other-services-text">
                <h3 class="type-h3">Precisa de Outro Serviço?</h3>
                <p class="type-body-16">Nós realizamos qualquer tipo de conserto no seu iPhone utilizando ferramentas
                  profissionais de laboratório e máxima transparência técnica na sua frente. Veja alguns dos outros
                  serviços mais realizados:</p>

                <ul class="other-services-bullets type-body-16">
                  <li><strong>Tampa Traseira de Vidro</strong> (Remoção a laser com acabamento de fábrica)</li>
                  <li><strong>Conector de Carga (Dock)</strong> (Seu iPhone não carrega ou tem mau contato)</li>
                  <li><strong>Câmeras Frontal e Traseira</strong> (Foco quebrado, lente trincada ou borrões)</li>
                  <li><strong>Reparo Avançado de Placa</strong> (Curto na linha primária, erro de carga, sem sinal)</li>
                  <li><strong>Vidro Frontal (Preservando a Tela Original)</strong> (Remanufatura OCA)</li>
                  <li><strong>Limpeza Química / Banho Químico</strong> (Recuperação de danos por água)</li>
                  <li><strong>Face ID / Touch ID</strong> (Recuperação do circuito biométrico original)</li>
                  <li><strong>Alto-falantes e Microfones</strong> (Áudio baixo, ruídos ou sem som)</li>
                </ul>
              </div>
              <div class="other-services-cta-card">
                <div class="cta-glow"></div>
                <div class="cta-card-inner">
                  <h4 class="type-heading-16">Orçamento Imediato</h4>
                  <p class="type-small-body">Consulte a disponibilidade de peças e agende o envio do técnico pelo
                    WhatsApp em menos de 5 minutos!</p>
                  <a href="#" class="btn-glow btn-whatsapp-global">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path
                        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
                    </svg>
                    <span>SOLICITAR OUTRO SERVIÇO</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
