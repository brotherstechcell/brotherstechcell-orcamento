---
export interface Step {
  step: number;
  title: string;
  desc: string;
  icon?: string;
}

interface Props {
  steps: Step[];
  title?: string;
  subtitle?: string;
}

const {
  steps,
  title = "Como Funciona o Atendimento Delivery",
  subtitle = "Sem filas, sem deixar o aparelho e com total segurança no seu endereço em Manaus."
} = Astro.props;

const defaultIcons = ["💬", "📅", "🛵", "🔧", "✅", "🛡️"];
---
<section class="service-how-it-works-section">
  <div class="container">
    <div class="section-header scroll-reveal scroll-top">
      <span class="section-label">Passo a Passo Transparente</span>
      <h2 class="section-title type-h2-44">{title}</h2>
      <p class="section-subtitle type-subheading-20">{subtitle}</p>
    </div>

    <div class="how-it-works-grid">
      {steps.map((s, idx) => (
        <div class="how-step-card">
          <!-- Top Row com Ícone Temático e Badge Numérico -->
          <div class="step-card-header">
            <div class="step-icon-box">
              <span class="step-emoji">{s.icon || defaultIcons[idx] || "📱"}</span>
            </div>
            <span class="step-badge-pill">Passo {String(s.step).padStart(2, '0')}</span>
          </div>

          <h3 class="step-card-title">{s.title.replace(/^\d+\.\s*/, '')}</h3>
          
          <div class="step-card-desc" set:html={s.desc} />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .service-how-it-works-section {
    padding: 70px 0;
    background: linear-gradient(180deg, #FAFAFA 0%, #F4F6F8 100%);
    border-top: 1px solid var(--border, #E5E7EB);
    border-bottom: 1px solid var(--border, #E5E7EB);
  }
  .how-it-works-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
    margin-top: 40px;
  }
  .how-step-card {
    position: relative;
    background: #FFFFFF;
    border: 1px solid rgba(229, 231, 235, 0.9);
    border-radius: var(--radius-lg, 20px);
    padding: 34px 28px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05), 0 1px 2px rgba(15, 23, 42, 0.03);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }
  .how-step-card:hover {
    transform: translateY(-5px);
    border-color: rgba(41, 162, 81, 0.45);
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.09), 0 4px 10px rgba(41, 162, 81, 0.06);
  }

  /* Cabeçalho do Card */
  .step-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }
  .step-icon-box {
    width: 48px;
    height: 48px;
    background: rgba(41, 162, 81, 0.08);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(41, 162, 81, 0.15);
    transition: transform 0.25s ease, background 0.25s ease;
  }
  .how-step-card:hover .step-icon-box {
    transform: scale(1.08);
    background: rgba(41, 162, 81, 0.14);
  }
  .step-emoji {
    font-size: 1.5rem;
    line-height: 1;
  }
  .step-badge-pill {
    background: var(--bg-secondary, #FAFAFA);
    border: 1px solid var(--border, #E5E7EB);
    color: var(--primary-dark, #1A532D);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: var(--radius-pill, 999px);
    box-shadow: var(--shadow-xs, 0 1px 2px rgba(0, 0, 0, 0.03));
  }

  .step-card-title {
    color: var(--text-primary, #111214);
    margin-bottom: 12px;
    font-weight: 700;
    font-size: 1.25rem;
    font-family: 'Outfit', sans-serif;
    line-height: 1.3;
  }
  .step-card-desc {
    color: var(--text-secondary, #4B5563);
    line-height: 1.65;
    font-size: 0.95rem;
  }
  .step-card-desc :global(strong) {
    color: var(--text-primary, #111214);
    font-weight: 700;
  }
</style>
