    <!-- Assistente de Pré-Diagnóstico Interativo -->
    <section id="diagnostico-wizard" class="diagnostic-section">
      <div class="container">
        <div class="diagnostic-card">
          <div class="diagnostic-glow"></div>
          <div class="diagnostic-card-inner">
            <span class="section-label" style="justify-content: center; margin-bottom: 12px;">Orçamento Rápido</span>
            <h2 class="type-h2-40" style="margin-bottom: 12px; text-align: center;">Não sabe qual é o defeito do seu
              iPhone?</h2>
            <p class="type-body-16"
              style="color: var(--text-secondary); text-align: center; max-width: 600px; margin: 0 auto 32px;">Selecione
              o sintoma e o seu aparelho abaixo para gerar um pré-diagnóstico instantâneo e falar direto com o nosso
              técnico especialista.</p>

            <div class="diagnostic-form-grid">
              <!-- Selecionador de Sintoma -->
              <div class="diagnostic-form-group">
                <label class="search-label">Selecione o Sintoma do Aparelho:</label>
                <div class="symptom-grid">
                  <button class="symptom-btn active" data-symptom="Troca de Tela (Tela Quebrada / Sem Toque)">
                    <span>📱</span> Tela Quebrada / Sem Toque
                  </button>
                  <button class="symptom-btn" data-symptom="Troca de Bateria (Bateria Viciada / Saúde Baixa)">
                    <span>🔋</span> Bateria Viciada / Saúde Baixa
                  </button>
                  <button class="symptom-btn" data-symptom="Problema de Carga (iPhone Não liga / Não carrega)">
                    <span>🔌</span> Não liga / Não carrega
                  </button>
                  <button class="symptom-btn" data-symptom="Reparo Avançado (Caiu na água / Molhou)">
                    <span>💧</span> Caiu na Água / Molhou
                  </button>
                  <button class="symptom-btn" data-symptom="Troca de Câmera (Foco quebrado / Lente trincada)">
                    <span>📸</span> Câmera Borrada ou Trincada
                  </button>
                  <button class="symptom-btn" data-symptom="Outros Serviços (Face ID / Tampa Traseira / Áudio)">
                    <span>⚙️</span> Outros Problemas / Dúvidas
                  </button>
                </div>
              </div>

              <!-- Selecionador de Modelo -->
              <div class="diagnostic-form-group">
                <label for="diagnostic-device-select" class="search-label">Selecione o Modelo do seu iPhone:</label>
                <div class="search-select-wrapper" style="max-width: 400px; margin: 0 auto;">
                  <select id="diagnostic-device-select" class="search-select-dropdown">
                    <!-- Será populado dinamicamente via JS de forma idêntica ao outro dropdown -->
                  </select>
                  <div class="select-arrow">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
                      <path d="M7 10l5 5 5-5H7z" />
                    </svg>
                  </div>
                </div>
              </div>
            </div>

            <div class="diagnostic-cta-wrapper" style="text-align: center; margin-top: 32px;">
              <a href="#" id="btn-submit-diagnostic" class="btn-glow btn-whatsapp-diagnostic" target="_blank"
                rel="noopener noreferrer" style="min-width: 320px;">
