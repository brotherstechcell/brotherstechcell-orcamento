---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TrustFacts from '../components/TrustFacts.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsapp from '../components/FloatingWhatsapp.astro';
import BottomNav from '../components/BottomNav.astro';
import { MANAUS_COVERAGE_ZONES, ALL_MANAUS_NEIGHBORHOODS, COVERAGE_FAQS } from '../data/regionsData';
import { SITE_URL, BUSINESS_INFO, getWhatsAppLink } from '../data/siteConfig';

const siteUrl = SITE_URL;

const areasJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${siteUrl}/areas-atendidas-manaus#service-area`,
  "name": `${BUSINESS_INFO.name} - Cobertura de Atendimento Delivery em Manaus`,
  "telephone": BUSINESS_INFO.phone,
  "url": `${siteUrl}/areas-atendidas-manaus`,
  "areaServed": MANAUS_COVERAGE_ZONES.map((zone) => ({
    "@type": "AdministrativeArea",
    "name": `${zone.zoneName} de Manaus`,
    "containsPlace": zone.neighborhoods.map((b) => ({
      "@type": "Place",
      "name": `Bairro ${b}, Manaus - AM`
    }))
  })),
  "description": "Assistência técnica especializada em iPhone com atendimento delivery em todas as zonas e bairros de Manaus - AM."
});

const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": COVERAGE_FAQS.map(({ question, answer }) => ({
    "@type": "Question",
    "name": question,
    "acceptedAnswer": { "@type": "Answer", "text": answer }
  }))
});

const breadcrumbJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Início", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Áreas Atendidas em Manaus", "item": `${siteUrl}/areas-atendidas-manaus` },
  ],
});
---
<BaseLayout
  title="Bairros Atendidos em Manaus | Assistência iPhone Delivery"
  description="Conserto de iPhone em domicílio em todos os bairros de Manaus: Adrianópolis, Ponta Negra, Vieiralves, Parque 10, Flores e mais. Chegada em até 40 min."
  canonicalPath="/areas-atendidas-manaus"
  extraJsonLd={[areasJsonLd, faqJsonLd, breadcrumbJsonLd]}
>
  <Header />
  <Breadcrumb items={[{ name: "Áreas Atendidas em Manaus" }]} />
  <main>
    <!-- Hero da Cobertura -->
    <section class="areas-hero-section section-canvas-white">
      <div class="container">
        <div class="section-header scroll-reveal scroll-top">
          <span class="section-label">Cobertura Municipal</span>
          <h1 class="section-title type-h2-44">Assistência Técnica de iPhone Delivery em Toda Manaus</h1>
          <p class="section-subtitle type-subheading-20">
            Nós vamos até você! Atendimento especializado na sua casa, escritório ou condomínio em todas as zonas da capital amazonense.
          </p>
        </div>

        <div class="quick-stats-strip">
          <div class="quick-stat-item">
            <span class="stat-number">6</span>
            <span class="stat-label">Zonas de Manaus</span>
          </div>
          <div class="quick-stat-item">
            <span class="stat-number">100%</span>
            <span class="stat-label">Bairros Atendidos</span>
          </div>
          <div class="quick-stat-item">
            <span class="stat-number">20 a 40m</span>
            <span class="stat-label">Tempo Médio de Chegada</span>
          </div>
          <div class="quick-stat-item">
            <span class="stat-number">0 R$</span>
            <span class="stat-label">Taxa p/ Maioria dos Bairros</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Zonas e Bairros de Manaus -->
    <section class="zones-coverage-section section-canvas-parchment">
      <div class="container">
        <div class="section-header scroll-reveal scroll-top">
          <span class="section-label">Regiões Atendidas</span>
          <h2 class="section-title type-h2-44">Encontre Sua Região em Manaus</h2>
          <p class="section-subtitle type-subheading-20">Nossos técnicos estão distribuídos estrategicamente pela cidade para atendimento rápido.</p>
        </div>

        <div class="zones-grid">
          {MANAUS_COVERAGE_ZONES.map((zone) => (
            <div class="zone-card store-utility-card">
              <div class="zone-card-header">
                <div>
                  <span class="zone-badge">{zone.badge}</span>
                  <h3 class="zone-title type-heading-20">{zone.zoneName}</h3>
                </div>
                <span class="zone-time-tag">⏱️ {zone.estimatedArrival}</span>
              </div>

              <p class="zone-desc type-small-body">{zone.description}</p>

              <div class="zone-neighborhoods-box">
                <span class="box-label">Bairros Atendidos:</span>
                <div class="neighborhoods-tags-container">
                  {zone.neighborhoods.map((bairro) => (
                    <span class="neighborhood-tag">{bairro}</span>
                  ))}
                </div>
              </div>

              <div class="zone-card-cta">
                <a href={getWhatsAppLink(`Olá! Estou no bairro ${zone.neighborhoods[0]} (${zone.zoneName}) e gostaria de agendar um atendimento delivery para iPhone.`)} class="btn-zone-request">
                  <span>Solicitar Técnico Nesta Região</span>
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Como Funciona o Deslocamento Delivery -->
    <section class="delivery-explanation-section section-canvas-white">
      <div class="container">
        <div class="delivery-explanation-box store-utility-card">
          <div class="section-header scroll-reveal scroll-top" style="margin-bottom: 32px;">
            <span class="section-label">Praticidade Absoluta</span>
            <h2 class="type-h2-32">Como Funciona o Atendimento Delivery em Manaus?</h2>
          </div>
          <div class="explanation-steps-grid">
            <div class="exp-step">
              <div class="exp-icon">📱</div>
              <h3 class="type-heading-18">1. Solicitação</h3>
              <p class="type-small-body">Você entra em contato pelo WhatsApp, informa seu modelo de iPhone, defeito e endereço em Manaus.</p>
            </div>
            <div class="exp-step">
              <div class="exp-icon">🚗</div>
              <h3 class="type-heading-18">2. Deslocamento</h3>
              <p class="type-small-body">Nosso técnico se desloca até seu endereço no horário combinado com ferramental profissional.</p>
            </div>
            <div class="exp-step">
              <div class="exp-icon">⚡</div>
              <h3 class="type-heading-18">3. Reparo no Local</h3>
              <p class="type-small-body">A troca de tela, bateria e periféricos é feita na sua frente em 20 a 40 minutos com total segurança de dados.</p>
            </div>
            <div class="exp-step">
              <div class="exp-icon">🛡️</div>
              <h3 class="type-heading-18">4. Teste e Garantia</h3>
              <p class="type-small-body">Você testa todos os recursos do seu iPhone e recebe a garantia de até 6 meses antes de efetuar o pagamento.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Prova Social & Fatos de Confiança -->
    <TrustFacts />

    <!-- FAQ de Cobertura -->
    <section class="faq-section">
      <div class="container">
        <div class="section-header scroll-reveal scroll-top">
          <span class="section-label">Perguntas Frequentes</span>
          <h2 class="section-title type-h2-44">Dúvidas sobre Atendimento em Manaus</h2>
        </div>

        <div class="faq-list" style="max-width: 760px; margin: 32px auto 0;">
          {COVERAGE_FAQS.map((faq) => (
            <div class="faq-item">
              <button class="faq-question" aria-expanded="false">
                <span>{faq.question}</span>
                <span class="faq-question-icon">+</span>
              </button>
              <div class="faq-answer">
                <div class="faq-answer-inner">
                  <p>{faq.answer}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <CtaFinal />
  </main>
  <Footer />
  <FloatingWhatsapp />
  <BottomNav />
  <script src="../scripts/prices.js"></script>
  <script src="../scripts/main.js"></script>
</BaseLayout>

<style>
  .areas-hero-section {
    padding: 40px 0 60px;
    text-align: center;
  }
  .quick-stats-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    margin-top: 36px;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }
  .quick-stat-item {
    background: #FFFFFF;
    border: 1px solid var(--border, #E5E7EB);
    border-radius: var(--radius-md, 14px);
    padding: 20px 16px;
    box-shadow: var(--shadow-sm, 0 2px 8px rgba(15, 23, 42, 0.06));
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .stat-number {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--primary, #29A251);
    font-family: 'Outfit', sans-serif;
    line-height: 1.2;
    margin-bottom: 4px;
  }
  .stat-label {
    font-size: 0.8rem;
    color: var(--text-muted, #6B7280);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .zones-coverage-section {
    padding: 60px 0;
    background-color: var(--bg-secondary, #FAFAFA);
    border-top: 1px solid var(--border, #E5E7EB);
    border-bottom: 1px solid var(--border, #E5E7EB);
  }
  .zones-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
    margin-top: 36px;
  }
  .zone-card {
    background: #FFFFFF;
    border: 1px solid var(--border, #E5E7EB);
    border-radius: var(--radius-md, 16px);
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm, 0 2px 8px rgba(15, 23, 42, 0.06));
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .zone-card:hover {
    transform: translateY(-4px);
    border-color: rgba(41, 162, 81, 0.4);
    box-shadow: var(--shadow-md, 0 8px 24px rgba(15, 23, 42, 0.08));
  }
  .zone-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
    gap: 12px;
  }
  .zone-badge {
    background: var(--primary-transparent, rgba(41, 162, 81, 0.08));
    color: var(--primary-dark, #1A532D);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--radius-pill, 999px);
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 6px;
  }
  .zone-title {
    color: var(--text-primary, #111214);
    font-family: 'Outfit', sans-serif;
    font-size: 1.25rem;
    margin: 0;
  }
  .zone-time-tag {
    font-size: 0.82rem;
    color: var(--text-muted, #6B7280);
    background: #F3F4F6;
    border: 1px solid var(--border, #E5E7EB);
    padding: 4px 10px;
    border-radius: var(--radius-pill, 999px);
    white-space: nowrap;
    font-weight: 600;
  }
  .zone-desc {
    color: var(--text-secondary, #4B5563);
    line-height: 1.6;
    margin-bottom: 20px;
  }
  .zone-neighborhoods-box {
    background: #F9FAFB;
    border: 1px solid var(--border, #E5E7EB);
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 24px;
    flex-grow: 1;
  }
  .box-label {
    display: block;
    font-size: 0.78rem;
    color: var(--text-muted, #6B7280);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: 12px;
  }
  .neighborhoods-tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .neighborhood-tag {
    background: #FFFFFF;
    color: var(--text-primary, #111214);
    font-size: 0.82rem;
    font-weight: 500;
    padding: 5px 10px;
    border-radius: 6px;
    border: 1px solid var(--border, #E5E7EB);
  }
  .btn-zone-request {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 12px 16px;
    border-radius: var(--radius-pill, 999px);
    background: var(--primary, #29A251);
    color: #FFFFFF;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .btn-zone-request:hover {
    background: var(--primary-dark, #1A532D);
    transform: translateY(-2px);
  }
  .delivery-explanation-section {
    padding: 60px 0;
  }
  .delivery-explanation-box {
    background: #FFFFFF;
    border: 1px solid var(--border, #E5E7EB);
    border-radius: var(--radius-lg, 20px);
    padding: 48px 36px;
    box-shadow: var(--shadow-sm, 0 2px 8px rgba(15, 23, 42, 0.06));
  }
  .explanation-steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
    margin-top: 24px;
  }
  .exp-step {
    color: var(--text-primary, #111214);
  }
  .exp-icon {
    font-size: 2.2rem;
    margin-bottom: 12px;
  }
  .exp-step h3 {
    margin-bottom: 8px;
    font-size: 1.15rem;
    font-family: 'Outfit', sans-serif;
  }
  .exp-step p {
    color: var(--text-secondary, #4B5563);
    line-height: 1.6;
  }
</style>
