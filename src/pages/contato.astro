---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TrustFacts from '../components/TrustFacts.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsapp from '../components/FloatingWhatsapp.astro';
import BottomNav from '../components/BottomNav.astro';
import { SITE_URL, BUSINESS_INFO, getWhatsAppLink } from '../data/siteConfig';

const siteUrl = SITE_URL;

const contactJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": `${siteUrl}/contato#webpage`,
  "name": `Contato - ${BUSINESS_INFO.name}`,
  "description": "Entre em contato com a Brothers Techcell para agendamento de assistência técnica delivery de iPhone em Manaus.",
  "mainEntity": {
    "@type": "LocalBusiness",
    "name": BUSINESS_INFO.name,
    "telephone": BUSINESS_INFO.phone,
    "email": BUSINESS_INFO.email,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Manaus",
      "addressRegion": "AM",
      "addressCountry": "BR"
    }
  }
});

const breadcrumbJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Início", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Contato", "item": `${siteUrl}/contato` },
  ],
});
---
<BaseLayout
  title="Fale Conosco | Brothers Techcell - Assistência iPhone Delivery Manaus"
  description="Entre em contato com a Brothers Techcell. Atendimento rápido via WhatsApp, agendamento de delivery e suporte técnico em Manaus - AM."
  canonicalPath="/contato"
  extraJsonLd={[contactJsonLd, breadcrumbJsonLd]}
>
  <Header />
  <Breadcrumb items={[{ name: "Contato" }]} />
  <main>
    <section class="contact-hero-section">
      <div class="container" style="max-width: 860px;">
        <div class="section-header scroll-reveal scroll-top">
          <span class="section-label">Canais Oficiais</span>
          <h1 class="section-title type-h2-44">Fale com a Brothers Techcell em Manaus</h1>
          <p class="section-subtitle type-subheading-20">
            Estamos prontos para atender você com rapidez. Solicite seu orçamento, tire dúvidas ou agende o envio de um técnico até seu endereço.
          </p>
        </div>

        <div class="contact-cards-grid">
          <!-- WhatsApp Card -->
          <div class="contact-info-card">
            <div class="contact-card-icon">💬</div>
            <h2 class="type-heading-18" style="color: var(--text-primary); margin-bottom: 6px;">WhatsApp Oficial</h2>
            <p class="type-small-body" style="color: var(--text-secondary); margin-bottom: 16px;">Canal prioritário para orçamentos rápidos e envio de técnicos.</p>
            <a href={getWhatsAppLink()} class="btn-contact-action btn-whatsapp-global">
              {BUSINESS_INFO.phone}
            </a>
          </div>

          <!-- Horário Card -->
          <div class="contact-info-card">
            <div class="contact-card-icon">⏰</div>
            <h2 class="type-heading-18" style="color: var(--text-primary); margin-bottom: 6px;">Horário de Atendimento</h2>
            <p class="type-small-body" style="color: var(--text-secondary); margin-bottom: 16px;">Atendemos de domingo a domingo com agendamento flexível.</p>
            <span class="contact-text-highlight">Todos os dias: 08h às 20h</span>
          </div>

          <!-- Região Card -->
          <div class="contact-info-card">
            <div class="contact-card-icon">📍</div>
            <h2 class="type-heading-18" style="color: var(--text-primary); margin-bottom: 6px;">Atendimento Delivery</h2>
            <p class="type-small-body" style="color: var(--text-secondary); margin-bottom: 16px;">Nós vamos até você em todas as zonas e bairros de Manaus.</p>
            <span class="contact-text-highlight">Manaus - AM (Em Domicílio)</span>
          </div>

          <!-- Instagram Card -->
          <div class="contact-info-card">
            <div class="contact-card-icon">📸</div>
            <h2 class="type-heading-18" style="color: var(--text-primary); margin-bottom: 6px;">Instagram</h2>
            <p class="type-small-body" style="color: var(--text-secondary); margin-bottom: 16px;">Acompanhe reparos reais, depoimentos e bastidores do delivery.</p>
            <a href={BUSINESS_INFO.instagramUrl} target="_blank" rel="noopener noreferrer" class="btn-contact-action instagram">
              @{BUSINESS_INFO.instagram}
            </a>
          </div>
        </div>
      </div>
    </section>

    <TrustFacts />
    <CtaFinal />
  </main>
  <Footer />
  <FloatingWhatsapp />
  <BottomNav />
  <script src="../scripts/prices.js"></script>
  <script src="../scripts/main.js"></script>
</BaseLayout>

<style>
  .contact-hero-section {
    padding: 40px 0 80px;
    background-color: var(--bg-secondary, #FAFAFA);
  }
  .contact-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-top: 40px;
  }
  .contact-info-card {
    background: var(--card-bg, #FFFFFF);
    border: 1px solid var(--border, #E5E7EB);
    border-radius: var(--radius-md, 16px);
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    box-shadow: var(--shadow-sm, 0 2px 8px rgba(15, 23, 42, 0.06));
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .contact-info-card:hover {
    transform: translateY(-4px);
    border-color: rgba(41, 162, 81, 0.4);
    box-shadow: var(--shadow-md, 0 8px 24px rgba(15, 23, 42, 0.08));
  }
  .contact-card-icon {
    font-size: 2.2rem;
    margin-bottom: 14px;
  }
  .btn-contact-action {
    display: inline-flex;
    align-items: center;
    background: var(--primary, #29A251);
    color: #FFFFFF;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 10px 18px;
    border-radius: var(--radius-pill, 999px);
    text-decoration: none;
    transition: background 0.2s ease;
    margin-top: auto;
  }
  .btn-contact-action:hover {
    background: var(--primary-dark, #1A532D);
  }
  .btn-contact-action.instagram {
    background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
  }
  .contact-text-highlight {
    color: var(--primary-dark, #1A532D);
    background: var(--primary-transparent, rgba(41, 162, 81, 0.08));
    font-weight: 700;
    font-size: 0.88rem;
    padding: 6px 12px;
    border-radius: var(--radius-pill, 999px);
    margin-top: auto;
  }
</style>
