---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsapp from '../components/FloatingWhatsapp.astro';
import BottomNav from '../components/BottomNav.astro';
import { getWhatsAppLink } from '../data/siteConfig';
---
<BaseLayout
  title="Página Não Encontrada (404) | Brothers Techcell Manaus"
  description="A página que você procura não foi encontrada. Acesse nossa página inicial ou consulte o orçamento do seu iPhone pelo WhatsApp."
  canonicalPath="/404"
  noindex={true}
>
  <Header />
  <main>
    <section class="not-found-section">
      <div class="container" style="max-width: 680px; text-align: center;">
        <div class="error-badge">Erro 404</div>
        <h1 class="error-title type-h2-44">Página Não Encontrada</h1>
        <p class="error-desc type-subheading-20">
          O link que você tentou acessar pode ter sido alterado, removido ou o endereço foi digitado incorretamente.
        </p>

        <div class="error-actions-grid">
          <a href="/" class="btn-error-action primary">
            <span>Voltar para o Início</span>
          </a>
          <a href="/#telas-precos" class="btn-error-action">
            <span>Consultar Tabela de Preços</span>
          </a>
          <a href="/iphone" class="btn-error-action">
            <span>Escolher Modelo de iPhone</span>
          </a>
          <a href="/areas-atendidas-manaus" class="btn-error-action">
            <span>Ver Áreas Atendidas</span>
          </a>
          <a href={getWhatsAppLink("Olá! Não encontrei a página que procurava no site e gostaria de tirar uma dúvida.")} class="btn-error-action whatsapp btn-whatsapp-global">
            <span>Falar no WhatsApp</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <FloatingWhatsapp />
  <BottomNav />
  <script src="../scripts/prices.js"></script>
  <script src="../scripts/main.js"></script>
</BaseLayout>

<style>
  .not-found-section {
    padding: 140px 0 100px;
    min-height: 70vh;
    display: flex;
    align-items: center;
    background-color: var(--bg-secondary, #FAFAFA);
  }
  .error-badge {
    display: inline-block;
    background: rgba(239, 68, 68, 0.1);
    color: #DC2626;
    font-weight: 800;
    padding: 6px 18px;
    border-radius: var(--radius-pill, 999px);
    border: 1px solid rgba(239, 68, 68, 0.2);
    margin-bottom: 24px;
    font-size: 0.85rem;
  }
  .error-title {
    color: var(--text-primary, #111214);
    margin-bottom: 16px;
  }
  .error-desc {
    color: var(--text-secondary, #4B5563);
    line-height: 1.6;
    margin-bottom: 40px;
  }
  .error-actions-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  .btn-error-action {
    background: #FFFFFF;
    border: 1px solid var(--border, #E5E7EB);
    color: var(--text-primary, #111214);
    padding: 12px 24px;
    border-radius: var(--radius-pill, 999px);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    box-shadow: var(--shadow-xs, 0 1px 2px rgba(15, 23, 42, 0.04));
    transition: all 0.2s ease;
  }
  .btn-error-action:hover {
    background: #FFFFFF;
    border-color: rgba(41, 162, 81, 0.4);
    color: var(--primary, #29A251);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm, 0 2px 8px rgba(15, 23, 42, 0.06));
  }
  .btn-error-action.primary {
    background: var(--primary, #29A251);
    border-color: var(--primary, #29A251);
    color: #FFFFFF;
  }
  .btn-error-action.primary:hover {
    background: var(--primary-dark, #1A532D);
    color: #FFFFFF;
  }
  .btn-error-action.whatsapp {
    background: var(--primary-transparent, rgba(41, 162, 81, 0.08));
    border-color: rgba(41, 162, 81, 0.25);
    color: var(--primary-dark, #1A532D);
  }
</style>
